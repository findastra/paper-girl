  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "d1_databases": [
    { "binding": "DB", "database_name": "paper-girl-chromesthesia", "database_id": "92408c8f-4211-434b-b41a-63a6acec55e8" }
  ]
}
